# Written for real by `provision`. This example exists so the shape is obvious
# and so the secret scan has something to skip (.env.example is exempt).
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<publishable key>
SUPABASE_SECRET_KEY=<secret key — server only, never NEXT_PUBLIC_*>
