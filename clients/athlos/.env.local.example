# ATHLOS environment variables
# Copy this file to .env.local and fill in the values.
# .env.local is gitignored — never commit real keys.

# ---------- Supabase ----------
# Create a free project at https://supabase.com/dashboard
# Settings → API → "Project URL" and "anon public" key
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Service role key — server-only, used for privileged operations (e.g. webhooks)
# Settings → API → "service_role secret"
# NEVER expose this in the browser
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# ---------- Stripe (test mode) ----------
# Dashboard → Developers → API keys → "Reveal test key"
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Price IDs created in Stripe Dashboard → Products
STRIPE_PRICE_BASIC=price_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_ELITE=price_...

# Membership opens only when this is "live". Until then /api/checkout returns 503.
LAUNCH_MODE=prelaunch

# ---------- Newsletter tool (double opt-in + weekly promos) ----------
# Default provider is Beehiiv. To use ConvertKit instead, set ESP_PROVIDER=convertkit.
ESP_PROVIDER=beehiiv
# Beehiiv → Settings → API: create a key. Publication ID looks like "pub_xxxxx".
BEEHIIV_API_KEY=
BEEHIIV_PUBLICATION_ID=
# ConvertKit/Kit (only if ESP_PROVIDER=convertkit)
# CONVERTKIT_API_KEY=
# CONVERTKIT_FORM_ID=

# ---------- Google Sheet (live list of signups) ----------
# Deploy scripts/athlos-waitlist-sheet.gs as an Apps Script Web App, paste the /exec URL.
SHEETS_WEBHOOK_URL=
# Optional shared secret — must match SHEET_SECRET inside the Apps Script.
SHEETS_WEBHOOK_SECRET=

# ---------- Anthropic ----------
# Ian's key lives at ~/.anthropic_key — paste it here
ANTHROPIC_API_KEY=sk-ant-...

# ---------- App ----------
NEXT_PUBLIC_APP_URL=http://localhost:3001
